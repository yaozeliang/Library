# Copy to .env and edit. Do not commit .env.
# core.settings works with these unset (SQLite, DEBUG on, a local SECRET_KEY).
# core.settings_production refuses a missing or placeholder SECRET_KEY.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
SERVER=127.0.0.1

# Leave unset for SQLite. Placeholder only; do not commit a real password.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# Password for a newly created demo superuser (`admin`) only. Placeholder.
# Unset: the local seed uses admin. Set this on a shared host before the first seed.
# Re-running scripts/seed_library_demo.py leaves existing passwords unchanged.
# Set DEMO_RESET_PASSWORDS=1 (or pass --reset-passwords) to write defaults again.
# DEMO_ADMIN_PASSWORD=change-me
