# Django Library Management System Environment Configuration
# Copy this file to .env and update the values for your environment

# ==============================================================================
# DJANGO SETTINGS
# ==============================================================================

# SECURITY WARNING: keep the secret key used in production secret!
# core.settings_production refuses to start if SECRET_KEY is missing or still
# this placeholder (or the old hardcoded S#perS3crEt_1122).
SECRET_KEY=your-secret-key-here-change-this-in-production

# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=False

# Allowed hosts (space-separated)
# For Cloud Run, use *.REGION.run.app (e.g., *.europe-west1.run.app)
ALLOWED_HOSTS=localhost 127.0.0.1 yourdomain.com *.europe-west1.run.app

# Environment (development, staging, production)
ENVIRONMENT=production

# Django settings module
DJANGO_SETTINGS_MODULE=core.settings_production

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# Leave DATABASE_URL unset to use local SQLite.
# DigitalOcean Managed Postgres: database defaultdb, schema library.
# sslmode=require and the URL-encoded search_path keep connections on that schema.
# Do not commit real credentials (.env, .env.library.postgres).
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require&options=-csearch_path%3Dlibrary

# Database connection pooling
CONN_MAX_AGE=60

# ==============================================================================
# CACHE CONFIGURATION
# ==============================================================================

# Redis URL for caching.
# Django 2.2 uses django-redis 5.2 (django_redis.cache.RedisCache).
# Do not point this at django.core.cache.backends.redis.RedisCache; that
# backend does not exist until Django 4.0 and rejects CLIENT_CLASS.
REDIS_URL=redis://localhost:6379/1

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================

# Email backend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Default from email
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================

# SSL/HTTPS settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# Session security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# CSRF protection
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax

# ==============================================================================
# ADMIN CONFIGURATION
# ==============================================================================

# Admin URL (change from default 'admin/' for security)
ADMIN_URL=admin/

# Superuser configuration (for automated deployment)
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=secure-admin-password
DJANGO_SUPERUSER_USERNAME=admin

# ==============================================================================
# THIRD-PARTY INTEGRATIONS
# ==============================================================================

# Sentry for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==============================================================================
# DEPLOYMENT SETTINGS
# ==============================================================================

# Time zone
TIME_ZONE=UTC

# Run tests during deployment
RUN_TESTS=false

# ==============================================================================
# GOOGLE CLOUD STORAGE
# ==============================================================================

# Google Cloud Storage settings
GS_BUCKET_NAME=django-library-static
GS_PROJECT_ID=django-library-466514

# Google Cloud credentials (for service account authentication)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ==============================================================================
# CLOUD STORAGE (Alternative - AWS S3)
# ==============================================================================

# AWS S3 settings (if using S3 for static/media files)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=your-cloudfront-domain.com

# ==============================================================================
# LOGGING
# ==============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ==============================================================================
# PERFORMANCE SETTINGS
# ==============================================================================

# File upload limits (in bytes)
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760  # 10MB
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760  # 10MB

# ==============================================================================
# DEVELOPMENT SETTINGS (Only for development environment)
# ==============================================================================

# Set to True only in development
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False 